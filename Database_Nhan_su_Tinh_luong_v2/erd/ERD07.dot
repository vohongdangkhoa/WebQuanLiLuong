digraph ERD {
graph [rankdir=TB, nodesep=0.6, ranksep=0.7, splines=polyline, bgcolor="white", pad=0.3];
node [shape=plain, fontname="DejaVu Sans"];
edge [color="#7891a6",fontname="DejaVu Sans",fontsize=9,arrowsize=0.7];
"PAYMENT_BATCH" [label=<<TABLE BORDER="1" COLOR="#cbd5df" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#102c43"><FONT COLOR="white" POINT-SIZE="15"><B>PAYMENT_BATCH</B></FONT></TD></TR><TR><TD PORT="batch_id" ALIGN="LEFT"><FONT POINT-SIZE="13">batch_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">PK </FONT></TD></TR><TR><TD PORT="run_id" ALIGN="LEFT"><FONT POINT-SIZE="13">run_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">FK </FONT></TD></TR><TR><TD PORT="status" ALIGN="LEFT"><FONT POINT-SIZE="13">status</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">&#160;</FONT></TD></TR><TR><TD PORT="export_document_id" ALIGN="LEFT"><FONT POINT-SIZE="13">export_document_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">FK ?</FONT></TD></TR></TABLE>>];
"PAYMENT_ITEM" [label=<<TABLE BORDER="1" COLOR="#cbd5df" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#102c43"><FONT COLOR="white" POINT-SIZE="15"><B>PAYMENT_ITEM</B></FONT></TD></TR><TR><TD PORT="payment_item_id" ALIGN="LEFT"><FONT POINT-SIZE="13">payment_item_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">PK </FONT></TD></TR><TR><TD PORT="batch_id" ALIGN="LEFT"><FONT POINT-SIZE="13">batch_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">FK </FONT></TD></TR><TR><TD PORT="run_id" ALIGN="LEFT"><FONT POINT-SIZE="13">run_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">FK </FONT></TD></TR><TR><TD PORT="result_id" ALIGN="LEFT"><FONT POINT-SIZE="13">result_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">FK </FONT></TD></TR><TR><TD PORT="employee_id" ALIGN="LEFT"><FONT POINT-SIZE="13">employee_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">FK </FONT></TD></TR><TR><TD PORT="bank_account_id" ALIGN="LEFT"><FONT POINT-SIZE="13">bank_account_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">FK </FONT></TD></TR></TABLE>>];
"BANK_RECON_IMPORT" [label=<<TABLE BORDER="1" COLOR="#cbd5df" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#102c43"><FONT COLOR="white" POINT-SIZE="15"><B>BANK_RECON_IMPORT</B></FONT></TD></TR><TR><TD PORT="recon_import_id" ALIGN="LEFT"><FONT POINT-SIZE="13">recon_import_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">PK </FONT></TD></TR><TR><TD PORT="document_id" ALIGN="LEFT"><FONT POINT-SIZE="13">document_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">FK </FONT></TD></TR></TABLE>>];
"BANK_RECON_LINE" [label=<<TABLE BORDER="1" COLOR="#cbd5df" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#102c43"><FONT COLOR="white" POINT-SIZE="15"><B>BANK_RECON_LINE</B></FONT></TD></TR><TR><TD PORT="recon_line_id" ALIGN="LEFT"><FONT POINT-SIZE="13">recon_line_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">PK </FONT></TD></TR><TR><TD PORT="recon_import_id" ALIGN="LEFT"><FONT POINT-SIZE="13">recon_import_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">FK </FONT></TD></TR><TR><TD PORT="payment_item_id" ALIGN="LEFT"><FONT POINT-SIZE="13">payment_item_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">FK ?</FONT></TD></TR></TABLE>>];
"PAYSLIP" [label=<<TABLE BORDER="1" COLOR="#cbd5df" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#102c43"><FONT COLOR="white" POINT-SIZE="15"><B>PAYSLIP</B></FONT></TD></TR><TR><TD PORT="payslip_id" ALIGN="LEFT"><FONT POINT-SIZE="13">payslip_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">PK </FONT></TD></TR><TR><TD PORT="result_id" ALIGN="LEFT"><FONT POINT-SIZE="13">result_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">FK </FONT></TD></TR><TR><TD PORT="issued_by" ALIGN="LEFT"><FONT POINT-SIZE="13">issued_by</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">FK </FONT></TD></TR><TR><TD PORT="document_id" ALIGN="LEFT"><FONT POINT-SIZE="13">document_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">FK ?</FONT></TD></TR></TABLE>>];
"PAYMENT_BATCH" -> "PAYMENT_ITEM" [taillabel="1",headlabel="0..*",label=""];
"BANK_RECON_IMPORT" -> "BANK_RECON_LINE" [taillabel="1",headlabel="0..*",label=""];
"PAYMENT_ITEM" -> "BANK_RECON_LINE" [taillabel="0..1",headlabel="0..*",label=""];
}