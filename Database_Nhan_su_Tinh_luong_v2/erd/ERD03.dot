digraph ERD {
graph [rankdir=TB, nodesep=0.6, ranksep=0.7, splines=polyline, bgcolor="white", pad=0.3];
node [shape=plain, fontname="DejaVu Sans"];
edge [color="#7891a6",fontname="DejaVu Sans",fontsize=9,arrowsize=0.7];
"WORK_CALENDAR" [label=<<TABLE BORDER="1" COLOR="#cbd5df" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#102c43"><FONT COLOR="white" POINT-SIZE="15"><B>WORK_CALENDAR</B></FONT></TD></TR><TR><TD PORT="calendar_id" ALIGN="LEFT"><FONT POINT-SIZE="13">calendar_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">PK </FONT></TD></TR></TABLE>>];
"CALENDAR_DAY" [label=<<TABLE BORDER="1" COLOR="#cbd5df" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#102c43"><FONT COLOR="white" POINT-SIZE="15"><B>CALENDAR_DAY</B></FONT></TD></TR><TR><TD PORT="calendar_id" ALIGN="LEFT"><FONT POINT-SIZE="13">calendar_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">PK FK </FONT></TD></TR><TR><TD PORT="work_date" ALIGN="LEFT"><FONT POINT-SIZE="13">work_date</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">PK </FONT></TD></TR></TABLE>>];
"WORK_SHIFT" [label=<<TABLE BORDER="1" COLOR="#cbd5df" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#102c43"><FONT COLOR="white" POINT-SIZE="15"><B>WORK_SHIFT</B></FONT></TD></TR><TR><TD PORT="shift_id" ALIGN="LEFT"><FONT POINT-SIZE="13">shift_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">PK </FONT></TD></TR></TABLE>>];
"EMPLOYEE_SHIFT" [label=<<TABLE BORDER="1" COLOR="#cbd5df" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#102c43"><FONT COLOR="white" POINT-SIZE="15"><B>EMPLOYEE_SHIFT</B></FONT></TD></TR><TR><TD PORT="employee_shift_id" ALIGN="LEFT"><FONT POINT-SIZE="13">employee_shift_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">PK </FONT></TD></TR><TR><TD PORT="employee_id" ALIGN="LEFT"><FONT POINT-SIZE="13">employee_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">FK </FONT></TD></TR><TR><TD PORT="work_date" ALIGN="LEFT"><FONT POINT-SIZE="13">work_date</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">&#160;</FONT></TD></TR><TR><TD PORT="shift_id" ALIGN="LEFT"><FONT POINT-SIZE="13">shift_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">FK </FONT></TD></TR><TR><TD PORT="starts_at" ALIGN="LEFT"><FONT POINT-SIZE="13">starts_at</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">&#160;</FONT></TD></TR><TR><TD PORT="ends_at" ALIGN="LEFT"><FONT POINT-SIZE="13">ends_at</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">&#160;</FONT></TD></TR></TABLE>>];
"ATTENDANCE_IMPORT" [label=<<TABLE BORDER="1" COLOR="#cbd5df" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#102c43"><FONT COLOR="white" POINT-SIZE="15"><B>ATTENDANCE_IMPORT</B></FONT></TD></TR><TR><TD PORT="import_id" ALIGN="LEFT"><FONT POINT-SIZE="13">import_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">PK </FONT></TD></TR><TR><TD PORT="document_id" ALIGN="LEFT"><FONT POINT-SIZE="13">document_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">FK </FONT></TD></TR><TR><TD PORT="status" ALIGN="LEFT"><FONT POINT-SIZE="13">status</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">&#160;</FONT></TD></TR></TABLE>>];
"TIMEKEEPING_RAW" [label=<<TABLE BORDER="1" COLOR="#cbd5df" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#102c43"><FONT COLOR="white" POINT-SIZE="15"><B>TIMEKEEPING_RAW</B></FONT></TD></TR><TR><TD PORT="raw_id" ALIGN="LEFT"><FONT POINT-SIZE="13">raw_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">PK </FONT></TD></TR><TR><TD PORT="import_id" ALIGN="LEFT"><FONT POINT-SIZE="13">import_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">FK </FONT></TD></TR><TR><TD PORT="employee_id" ALIGN="LEFT"><FONT POINT-SIZE="13">employee_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">FK ?</FONT></TD></TR></TABLE>>];
"TIMESHEET_DAILY" [label=<<TABLE BORDER="1" COLOR="#cbd5df" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#102c43"><FONT COLOR="white" POINT-SIZE="15"><B>TIMESHEET_DAILY</B></FONT></TD></TR><TR><TD PORT="timesheet_id" ALIGN="LEFT"><FONT POINT-SIZE="13">timesheet_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">PK </FONT></TD></TR><TR><TD PORT="period_id" ALIGN="LEFT"><FONT POINT-SIZE="13">period_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">FK </FONT></TD></TR><TR><TD PORT="employee_id" ALIGN="LEFT"><FONT POINT-SIZE="13">employee_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">FK </FONT></TD></TR><TR><TD PORT="work_date" ALIGN="LEFT"><FONT POINT-SIZE="13">work_date</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">FK </FONT></TD></TR><TR><TD PORT="employee_shift_id" ALIGN="LEFT"><FONT POINT-SIZE="13">employee_shift_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">FK ?</FONT></TD></TR><TR><TD PORT="paid_minutes" ALIGN="LEFT"><FONT POINT-SIZE="13">paid_minutes</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">&#160;</FONT></TD></TR></TABLE>>];
"TIMESHEET_ADJUSTMENT" [label=<<TABLE BORDER="1" COLOR="#cbd5df" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#102c43"><FONT COLOR="white" POINT-SIZE="15"><B>TIMESHEET_ADJUSTMENT</B></FONT></TD></TR><TR><TD PORT="adjustment_id" ALIGN="LEFT"><FONT POINT-SIZE="13">adjustment_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">PK </FONT></TD></TR><TR><TD PORT="timesheet_id" ALIGN="LEFT"><FONT POINT-SIZE="13">timesheet_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">FK </FONT></TD></TR><TR><TD PORT="status" ALIGN="LEFT"><FONT POINT-SIZE="13">status</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">&#160;</FONT></TD></TR></TABLE>>];
"WORK_CALENDAR" -> "CALENDAR_DAY" [taillabel="1",headlabel="0..*",label=""];
"WORK_SHIFT" -> "EMPLOYEE_SHIFT" [taillabel="1",headlabel="0..*",label=""];
"ATTENDANCE_IMPORT" -> "TIMEKEEPING_RAW" [taillabel="1",headlabel="0..*",label=""];
"EMPLOYEE_SHIFT" -> "TIMESHEET_DAILY" [taillabel="0..1",headlabel="0..1",label=""];
"TIMESHEET_DAILY" -> "TIMESHEET_ADJUSTMENT" [taillabel="1",headlabel="0..*",label=""];
}