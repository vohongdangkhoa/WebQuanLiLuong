@startuml
hide circle
skinparam linetype ortho
entity APP_USER {
  user_id : NUMBER GENERATED BY
  username : VARCHAR2(100 CHAR)
  password_hash : VARCHAR2(500 CHAR)
  employee_id : NUMBER
  is_active : CHAR(1)
  security_version : NUMBER(10)
  created_at : TIMESTAMP WITH TIME ZONE
}
entity APP_ROLE {
  role_id : NUMBER GENERATED BY
  role_code : VARCHAR2(30 CHAR)
  role_name : VARCHAR2(100 CHAR)
}
entity USER_ROLE {
  user_id : NUMBER
  role_id : NUMBER
  granted_by : NUMBER
  granted_at : TIMESTAMP WITH TIME ZONE
}
APP_USER ||--o{ USER_ROLE : user_id
APP_ROLE ||--o{ USER_ROLE : role_id
APP_USER |o--o{ USER_ROLE : granted_by
@enduml