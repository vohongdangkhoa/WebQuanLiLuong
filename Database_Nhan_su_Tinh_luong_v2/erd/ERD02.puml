@startuml
hide circle
skinparam linetype ortho
entity DEPARTMENT {
  department_id : NUMBER GENERATED BY
  department_code : VARCHAR2(30 CHAR)
  department_name : VARCHAR2(150 CHAR)
  parent_id : NUMBER
  is_active : CHAR(1)
}
entity JOB_POSITION {
  position_id : NUMBER GENERATED BY
  position_code : VARCHAR2(30 CHAR)
  position_name : VARCHAR2(150 CHAR)
  is_active : CHAR(1)
}
entity EMPLOYEE {
  employee_id : NUMBER GENERATED BY
  employee_code : VARCHAR2(30 CHAR)
  full_name : VARCHAR2(150 CHAR)
  email : VARCHAR2(200 CHAR)
  birth_date : DATE
  hire_date : DATE
  termination_date : DATE
  tax_identifier_hash : VARCHAR2(128 CHAR)
  status : VARCHAR2(20 CHAR)
  row_version : NUMBER(10)
}
entity EMPLOYEE_ASSIGNMENT {
  assignment_id : NUMBER GENERATED BY
  employee_id : NUMBER
  department_id : NUMBER
  position_id : NUMBER
  valid_from : DATE
  valid_to : DATE
  created_by : NUMBER
}
entity EMPLOYMENT_CONTRACT {
  contract_id : NUMBER GENERATED BY
  employee_id : NUMBER
  contract_no : VARCHAR2(60 CHAR)
  valid_from : DATE
  valid_to : DATE
  monthly_salary : NUMBER(18,2)
  insurance_base : NUMBER(18,2)
  calendar_id : NUMBER
  insurance_enabled : CHAR(1)
  status : VARCHAR2(20 CHAR)
  created_by : NUMBER
  approved_by : NUMBER
  approved_at : TIMESTAMP WITH TIME ZONE
  document_id : NUMBER
}
entity EMPLOYEE_BANK_ACCOUNT {
  bank_account_id : NUMBER GENERATED BY
  employee_id : NUMBER
  bank_code : VARCHAR2(30 CHAR)
  account_ciphertext : VARCHAR2(2000 CHAR)
  account_last4 : CHAR(4)
  account_hmac : VARCHAR2(128 CHAR)
  holder_name : VARCHAR2(150 CHAR)
  valid_from : DATE
  valid_to : DATE
  status : VARCHAR2(20 CHAR)
  created_by : NUMBER
  verified_by : NUMBER
  verified_at : TIMESTAMP WITH TIME ZONE
}
entity DOCUMENT_FILE {
  document_id : NUMBER GENERATED BY
  storage_key : VARCHAR2(500 CHAR)
  original_name : VARCHAR2(255 CHAR)
  mime_type : VARCHAR2(100 CHAR)
  size_bytes : NUMBER(18)
  sha256 : CHAR(64)
  uploaded_by : NUMBER
  uploaded_at : TIMESTAMP WITH TIME ZONE
}
DEPARTMENT |o--o{ DEPARTMENT : parent_id
EMPLOYEE ||--o{ EMPLOYEE_ASSIGNMENT : employee_id
DEPARTMENT ||--o{ EMPLOYEE_ASSIGNMENT : department_id
JOB_POSITION ||--o{ EMPLOYEE_ASSIGNMENT : position_id
EMPLOYEE ||--o{ EMPLOYMENT_CONTRACT : employee_id
DOCUMENT_FILE |o--o{ EMPLOYMENT_CONTRACT : document_id
EMPLOYEE ||--o{ EMPLOYEE_BANK_ACCOUNT : employee_id
@enduml