@startuml
hide circle
skinparam linetype ortho
entity APP_USER {
  user_id : NUMBER GENERATED BY
  username : VARCHAR2(100 CHAR)
  password_hash : VARCHAR2(500 CHAR)
  employee_id : NUMBER
  is_active : CHAR(1)
  security_version : NUMBER(10)
  created_at : TIMESTAMP WITH TIME ZONE
}
entity APP_ROLE {
  role_id : NUMBER GENERATED BY
  role_code : VARCHAR2(30 CHAR)
  role_name : VARCHAR2(100 CHAR)
}
entity USER_ROLE {
  user_id : NUMBER
  role_id : NUMBER
  granted_by : NUMBER
  granted_at : TIMESTAMP WITH TIME ZONE
}
entity DEPARTMENT {
  department_id : NUMBER GENERATED BY
  department_code : VARCHAR2(30 CHAR)
  department_name : VARCHAR2(150 CHAR)
  parent_id : NUMBER
  is_active : CHAR(1)
}
entity JOB_POSITION {
  position_id : NUMBER GENERATED BY
  position_code : VARCHAR2(30 CHAR)
  position_name : VARCHAR2(150 CHAR)
  is_active : CHAR(1)
}
entity EMPLOYEE {
  employee_id : NUMBER GENERATED BY
  employee_code : VARCHAR2(30 CHAR)
  full_name : VARCHAR2(150 CHAR)
  email : VARCHAR2(200 CHAR)
  birth_date : DATE
  hire_date : DATE
  termination_date : DATE
  tax_identifier_hash : VARCHAR2(128 CHAR)
  status : VARCHAR2(20 CHAR)
  row_version : NUMBER(10)
}
entity EMPLOYEE_ASSIGNMENT {
  assignment_id : NUMBER GENERATED BY
  employee_id : NUMBER
  department_id : NUMBER
  position_id : NUMBER
  valid_from : DATE
  valid_to : DATE
  created_by : NUMBER
}
entity EMPLOYMENT_CONTRACT {
  contract_id : NUMBER GENERATED BY
  employee_id : NUMBER
  contract_no : VARCHAR2(60 CHAR)
  valid_from : DATE
  valid_to : DATE
  monthly_salary : NUMBER(18,2)
  insurance_base : NUMBER(18,2)
  calendar_id : NUMBER
  insurance_enabled : CHAR(1)
  status : VARCHAR2(20 CHAR)
  created_by : NUMBER
  approved_by : NUMBER
  approved_at : TIMESTAMP WITH TIME ZONE
  document_id : NUMBER
}
entity EMPLOYEE_BANK_ACCOUNT {
  bank_account_id : NUMBER GENERATED BY
  employee_id : NUMBER
  bank_code : VARCHAR2(30 CHAR)
  account_ciphertext : VARCHAR2(2000 CHAR)
  account_last4 : CHAR(4)
  account_hmac : VARCHAR2(128 CHAR)
  holder_name : VARCHAR2(150 CHAR)
  valid_from : DATE
  valid_to : DATE
  status : VARCHAR2(20 CHAR)
  created_by : NUMBER
  verified_by : NUMBER
  verified_at : TIMESTAMP WITH TIME ZONE
}
entity DOCUMENT_FILE {
  document_id : NUMBER GENERATED BY
  storage_key : VARCHAR2(500 CHAR)
  original_name : VARCHAR2(255 CHAR)
  mime_type : VARCHAR2(100 CHAR)
  size_bytes : NUMBER(18)
  sha256 : CHAR(64)
  uploaded_by : NUMBER
  uploaded_at : TIMESTAMP WITH TIME ZONE
}
entity WORK_CALENDAR {
  calendar_id : NUMBER GENERATED BY
  calendar_code : VARCHAR2(30 CHAR)
  calendar_name : VARCHAR2(150 CHAR)
}
entity CALENDAR_DAY {
  calendar_id : NUMBER
  work_date : DATE
  day_type : VARCHAR2(20 CHAR)
  standard_minutes : NUMBER(5)
}
entity WORK_SHIFT {
  shift_id : NUMBER GENERATED BY
  shift_code : VARCHAR2(30 CHAR)
  shift_name : VARCHAR2(100 CHAR)
  start_minute : NUMBER(4)
  end_minute : NUMBER(4)
  end_day_offset : NUMBER(1)
  break_minutes : NUMBER(4)
}
entity EMPLOYEE_SHIFT {
  employee_shift_id : NUMBER GENERATED BY
  employee_id : NUMBER
  work_date : DATE
  shift_id : NUMBER
  starts_at : TIMESTAMP
  ends_at : TIMESTAMP
  created_by : NUMBER
}
entity ATTENDANCE_IMPORT {
  import_id : NUMBER GENERATED BY
  file_sha256 : CHAR(64)
  document_id : NUMBER
  imported_by : NUMBER
  status : VARCHAR2(20 CHAR)
  created_at : TIMESTAMP WITH TIME ZONE
}
entity TIMEKEEPING_RAW {
  raw_id : NUMBER GENERATED BY
  import_id : NUMBER
  source_device : VARCHAR2(80 CHAR)
  source_event_key : VARCHAR2(100 CHAR)
  employee_id : NUMBER
  source_employee_code : VARCHAR2(50 CHAR)
  event_at : TIMESTAMP
  event_type : VARCHAR2(10 CHAR)
  validation_error : VARCHAR2(500 CHAR)
}
entity TIMESHEET_DAILY {
  timesheet_id : NUMBER GENERATED BY
  period_id : NUMBER
  employee_id : NUMBER
  work_date : DATE
  employee_shift_id : NUMBER
  first_in : TIMESTAMP
  last_out : TIMESTAMP
  worked_minutes : NUMBER(5)
  paid_leave_minutes : NUMBER(5)
  paid_holiday_minutes : NUMBER(5)
  paid_minutes : NUMBER(5)
  late_minutes : NUMBER(5)
  status : VARCHAR2(20 CHAR)
  error_message : VARCHAR2(500 CHAR)
  row_version : NUMBER(10)
}
entity TIMESHEET_ADJUSTMENT {
  adjustment_id : NUMBER GENERATED BY
  timesheet_id : NUMBER
  before_json : CLOB
  after_json : CLOB
  reason : VARCHAR2(1000 CHAR)
  requested_by : NUMBER
  approved_by : NUMBER
  status : VARCHAR2(20 CHAR)
  created_at : TIMESTAMP WITH TIME ZONE
}
entity LEAVE_TYPE {
  leave_type_id : NUMBER GENERATED BY
  leave_code : VARCHAR2(30 CHAR)
  leave_name : VARCHAR2(100 CHAR)
  paid_fraction : NUMBER(5,4)
  uses_balance : CHAR(1)
}
entity LEAVE_REQUEST {
  leave_id : NUMBER GENERATED BY
  employee_id : NUMBER
  leave_type_id : NUMBER
  starts_at : TIMESTAMP
  ends_at : TIMESTAMP
  reason : VARCHAR2(1000 CHAR)
  status : VARCHAR2(20 CHAR)
  requested_by : NUMBER
  decided_by : NUMBER
  decided_at : TIMESTAMP WITH TIME ZONE
  decision_reason : VARCHAR2(1000 CHAR)
  document_id : NUMBER
}
entity LEAVE_DAY {
  leave_id : NUMBER
  work_date : DATE
  minutes : NUMBER(5)
}
entity LEAVE_LEDGER {
  ledger_id : NUMBER GENERATED BY
  employee_id : NUMBER
  leave_type_id : NUMBER
  leave_id : NUMBER
  effective_date : DATE
  delta_minutes : NUMBER(8)
  source_key : VARCHAR2(100 CHAR)
  created_by : NUMBER
  reversal_of : NUMBER
}
entity OVERTIME_REQUEST {
  overtime_id : NUMBER GENERATED BY
  employee_id : NUMBER
  starts_at : TIMESTAMP
  ends_at : TIMESTAMP
  approved_minutes : NUMBER(6)
  actual_minutes : NUMBER(6)
  actual_starts_at : TIMESTAMP
  actual_ends_at : TIMESTAMP
  status : VARCHAR2(20 CHAR)
  requested_by : NUMBER
  approved_by : NUMBER
  confirmed_by : NUMBER
  reason : VARCHAR2(1000 CHAR)
}
entity OVERTIME_SEGMENT {
  segment_id : NUMBER GENERATED BY
  overtime_id : NUMBER
  work_date : DATE
  starts_at : TIMESTAMP
  ends_at : TIMESTAMP
  payable_minutes : NUMBER(5)
  is_night : CHAR(1)
}
entity DEPENDENT_PERSON {
  dependent_person_id : NUMBER GENERATED BY
  identity_hmac : VARCHAR2(128 CHAR)
  full_name : VARCHAR2(150 CHAR)
  birth_date : DATE
}
entity DEPENDENT_CLAIM {
  claim_id : NUMBER GENERATED BY
  dependent_person_id : NUMBER
  employee_id : NUMBER
  valid_from : DATE
  valid_to : DATE
  status : VARCHAR2(20 CHAR)
  document_id : NUMBER
  requested_by : NUMBER
  verified_by : NUMBER
  verified_at : TIMESTAMP WITH TIME ZONE
}
entity PAY_COMPONENT {
  component_id : NUMBER GENERATED BY
  component_code : VARCHAR2(30 CHAR)
  component_name : VARCHAR2(150 CHAR)
  component_kind : VARCHAR2(20 CHAR)
  taxable_fraction : NUMBER(5,4)
}
entity EMPLOYEE_ALLOWANCE {
  allowance_id : NUMBER GENERATED BY
  employee_id : NUMBER
  component_id : NUMBER
  amount : NUMBER(18,2)
  allocation_method : VARCHAR2(20 CHAR)
  valid_from : DATE
  valid_to : DATE
  status : VARCHAR2(20 CHAR)
  created_by : NUMBER
  approved_by : NUMBER
}
entity DEDUCTION_ACCOUNT {
  deduction_account_id : NUMBER GENERATED BY
  employee_id : NUMBER
  principal_amount : NUMBER(18,2)
  collected_amount : NUMBER(18,2)
  monthly_limit : NUMBER(18,2)
  opened_by : NUMBER
  description : VARCHAR2(500 CHAR)
}
entity BONUS_DEDUCTION {
  entry_id : NUMBER GENERATED BY
  employee_id : NUMBER
  period_id : NUMBER
  component_id : NUMBER
  amount : NUMBER(18,2)
  deduction_account_id : NUMBER
  origin_result_id : NUMBER
  reason : VARCHAR2(1000 CHAR)
  status : VARCHAR2(20 CHAR)
  created_by : NUMBER
  approved_by : NUMBER
}
entity PAYROLL_POLICY {
  policy_id : NUMBER GENERATED BY
  policy_code : VARCHAR2(40 CHAR)
  valid_from : DATE
  valid_to : DATE
  employee_insurance_rate : NUMBER(7,6)
  employer_insurance_rate : NUMBER(7,6)
  insurance_cap : NUMBER(18,2)
  personal_relief : NUMBER(18,2)
  dependent_relief : NUMBER(18,2)
  ot_workday_factor : NUMBER(7,4)
  ot_restday_factor : NUMBER(7,4)
  ot_holiday_factor : NUMBER(7,4)
  night_extra_factor : NUMBER(7,4)
  ot_taxable_fraction : NUMBER(5,4)
  round_scale : NUMBER(1)
  status : VARCHAR2(20 CHAR)
  created_by : NUMBER
  approved_by : NUMBER
  source_note : VARCHAR2(1000 CHAR)
  parameters_json : CLOB
}
entity TAX_BRACKET {
  bracket_id : NUMBER GENERATED BY
  policy_id : NUMBER
  lower_bound : NUMBER(18,2)
  upper_bound : NUMBER(18,2)
  rate : NUMBER(7,6)
}
entity PAYROLL_PERIOD {
  period_id : NUMBER GENERATED BY
  period_start : DATE
  period_end : DATE
  period_status : VARCHAR2(10 CHAR)
  timesheet_status : VARCHAR2(12 CHAR)
  input_version : NUMBER(10)
  locked_by : NUMBER
  locked_at : TIMESTAMP WITH TIME ZONE
}
entity PAYROLL_RUN {
  run_id : NUMBER GENERATED BY
  period_id : NUMBER
  version_no : NUMBER(10)
  request_key : VARCHAR2(100 CHAR)
  input_version : NUMBER(10)
  policy_id : NUMBER
  calculated_by : NUMBER
  status : VARCHAR2(20 CHAR)
  created_at : TIMESTAMP WITH TIME ZONE
  finished_at : TIMESTAMP WITH TIME ZONE
  success_count : NUMBER(8)
  error_count : NUMBER(8)
  engine_version : VARCHAR2(30 CHAR)
}
entity PAYROLL_RESULT {
  result_id : NUMBER GENERATED BY
  run_id : NUMBER
  employee_id : NUMBER
  employee_code_snapshot : VARCHAR2(30 CHAR)
  employee_name_snapshot : VARCHAR2(150 CHAR)
  department_id_snapshot : NUMBER
  department_name_snapshot : VARCHAR2(150 CHAR)
  gross_amount : NUMBER(18,2)
  employee_insurance : NUMBER(18,2)
  pit_amount : NUMBER(18,2)
  other_deduction : NUMBER(18,2)
  net_amount : NUMBER(18,2)
  employer_insurance : NUMBER(18,2)
  taxable_income : NUMBER(18,2)
  dependent_count : NUMBER(3)
}
entity PAYROLL_ITEM {
  item_id : NUMBER GENERATED BY
  result_id : NUMBER
  component_id : NUMBER
  component_code_snapshot : VARCHAR2(30 CHAR)
  kind_snapshot : VARCHAR2(20 CHAR)
  department_id : NUMBER
  source_type : VARCHAR2(30 CHAR)
  department_name_snapshot : VARCHAR2(150 CHAR)
  source_id : NUMBER
  source_date : DATE
  amount : NUMBER(18,2)
  taxable_amount : NUMBER(18,2)
  quantity : NUMBER(18,6)
  unit_rate : NUMBER(20,8)
  multiplier : NUMBER(10,6)
  formula_snapshot : VARCHAR2(1000 CHAR)
  policy_id : NUMBER
  deduction_account_id : NUMBER
}
entity PAYROLL_SNAPSHOT {
  snapshot_id : NUMBER GENERATED BY
  result_id : NUMBER
  source_type : VARCHAR2(30 CHAR)
  source_id : NUMBER
  snapshot_json : CLOB
}
entity PAYROLL_ERROR {
  error_id : NUMBER GENERATED BY
  run_id : NUMBER
  employee_id : NUMBER
  error_code : NUMBER(6)
  error_message : VARCHAR2(2000 CHAR)
  created_at : TIMESTAMP WITH TIME ZONE
}
entity PAYROLL_APPROVAL {
  approval_id : NUMBER GENERATED BY
  run_id : NUMBER
  action : VARCHAR2(20 CHAR)
  actor_id : NUMBER
  reason : VARCHAR2(1000 CHAR)
  acted_at : TIMESTAMP WITH TIME ZONE
}
entity INPUT_CHANGE_REQUEST {
  change_request_id : NUMBER GENERATED BY
  period_id : NUMBER
  employee_id : NUMBER
  source_type : VARCHAR2(30 CHAR)
  source_id : NUMBER
  reason : VARCHAR2(1000 CHAR)
  status : VARCHAR2(20 CHAR)
  requested_by : NUMBER
  resolved_by : NUMBER
  created_at : TIMESTAMP WITH TIME ZONE
}
entity PAYMENT_BATCH {
  batch_id : NUMBER GENERATED BY
  run_id : NUMBER
  request_key : VARCHAR2(100 CHAR)
  status : VARCHAR2(20 CHAR)
  created_by : NUMBER
  created_at : TIMESTAMP WITH TIME ZONE
  export_document_id : NUMBER
  export_sha256 : CHAR(64)
  exported_at : TIMESTAMP WITH TIME ZONE
}
entity PAYMENT_ITEM {
  payment_item_id : NUMBER GENERATED BY
  batch_id : NUMBER
  run_id : NUMBER
  result_id : NUMBER
  employee_id : NUMBER
  bank_account_id : NUMBER
  attempt_no : NUMBER(4)
  transfer_reference : VARCHAR2(80 CHAR)
  amount : NUMBER(18,2)
  bank_code_snapshot : VARCHAR2(30 CHAR)
  account_ciphertext_snapshot : VARCHAR2(2000 CHAR)
  account_last4_snapshot : CHAR(4)
  holder_name_snapshot : VARCHAR2(150 CHAR)
  status : VARCHAR2(20 CHAR)
  bank_transaction_id : VARCHAR2(100 CHAR)
  confirmed_at : TIMESTAMP WITH TIME ZONE
  failure_reason : VARCHAR2(1000 CHAR)
}
entity BANK_RECON_IMPORT {
  recon_import_id : NUMBER GENERATED BY
  file_sha256 : CHAR(64)
  document_id : NUMBER
  imported_by : NUMBER
  imported_at : TIMESTAMP WITH TIME ZONE
}
entity BANK_RECON_LINE {
  recon_line_id : NUMBER GENERATED BY
  recon_import_id : NUMBER
  line_no : NUMBER(8)
  payment_item_id : NUMBER
  transfer_reference : VARCHAR2(80 CHAR)
  bank_transaction_id : VARCHAR2(100 CHAR)
  reported_amount : NUMBER(18,2)
  bank_status : VARCHAR2(20 CHAR)
  failure_reason : VARCHAR2(1000 CHAR)
  match_status : VARCHAR2(20 CHAR)
}
entity PAYSLIP {
  payslip_id : NUMBER GENERATED BY
  result_id : NUMBER
  issued_by : NUMBER
  issued_at : TIMESTAMP WITH TIME ZONE
  document_id : NUMBER
}
entity AUDIT_LOG {
  audit_id : NUMBER GENERATED BY
  actor_id : NUMBER
  db_username : VARCHAR2(128 CHAR)
  entity_type : VARCHAR2(40 CHAR)
  entity_id : NUMBER
  action : VARCHAR2(40 CHAR)
  reason : VARCHAR2(1000 CHAR)
  before_json : CLOB
  after_json : CLOB
  correlation_key : VARCHAR2(100 CHAR)
  created_at : TIMESTAMP WITH TIME ZONE
}
entity APP_NOTIFICATION {
  notification_id : NUMBER GENERATED BY
  user_id : NUMBER
  title : VARCHAR2(200 CHAR)
  body : VARCHAR2(1000 CHAR)
  entity_type : VARCHAR2(40 CHAR)
  entity_id : NUMBER
  created_at : TIMESTAMP WITH TIME ZONE
  read_at : TIMESTAMP WITH TIME ZONE
}
entity SYSTEM_MUTEX {
  lock_key : VARCHAR2(40 CHAR) PRIMARY KEY
  description : VARCHAR2(200 CHAR)
}
