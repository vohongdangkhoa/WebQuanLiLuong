digraph ERD {
graph [rankdir=TB, nodesep=0.6, ranksep=0.7, splines=polyline, bgcolor="white", pad=0.3];
node [shape=plain, fontname="DejaVu Sans"];
edge [color="#7891a6",fontname="DejaVu Sans",fontsize=9,arrowsize=0.7];
"LEAVE_TYPE" [label=<<TABLE BORDER="1" COLOR="#cbd5df" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#102c43"><FONT COLOR="white" POINT-SIZE="15"><B>LEAVE_TYPE</B></FONT></TD></TR><TR><TD PORT="leave_type_id" ALIGN="LEFT"><FONT POINT-SIZE="13">leave_type_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">PK </FONT></TD></TR></TABLE>>];
"LEAVE_REQUEST" [label=<<TABLE BORDER="1" COLOR="#cbd5df" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#102c43"><FONT COLOR="white" POINT-SIZE="15"><B>LEAVE_REQUEST</B></FONT></TD></TR><TR><TD PORT="leave_id" ALIGN="LEFT"><FONT POINT-SIZE="13">leave_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">PK </FONT></TD></TR><TR><TD PORT="employee_id" ALIGN="LEFT"><FONT POINT-SIZE="13">employee_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">FK </FONT></TD></TR><TR><TD PORT="leave_type_id" ALIGN="LEFT"><FONT POINT-SIZE="13">leave_type_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">FK </FONT></TD></TR><TR><TD PORT="starts_at" ALIGN="LEFT"><FONT POINT-SIZE="13">starts_at</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">&#160;</FONT></TD></TR><TR><TD PORT="ends_at" ALIGN="LEFT"><FONT POINT-SIZE="13">ends_at</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">&#160;</FONT></TD></TR><TR><TD PORT="status" ALIGN="LEFT"><FONT POINT-SIZE="13">status</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">&#160;</FONT></TD></TR></TABLE>>];
"LEAVE_DAY" [label=<<TABLE BORDER="1" COLOR="#cbd5df" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#102c43"><FONT COLOR="white" POINT-SIZE="15"><B>LEAVE_DAY</B></FONT></TD></TR><TR><TD PORT="leave_id" ALIGN="LEFT"><FONT POINT-SIZE="13">leave_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">PK FK </FONT></TD></TR><TR><TD PORT="work_date" ALIGN="LEFT"><FONT POINT-SIZE="13">work_date</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">PK </FONT></TD></TR></TABLE>>];
"LEAVE_LEDGER" [label=<<TABLE BORDER="1" COLOR="#cbd5df" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#102c43"><FONT COLOR="white" POINT-SIZE="15"><B>LEAVE_LEDGER</B></FONT></TD></TR><TR><TD PORT="ledger_id" ALIGN="LEFT"><FONT POINT-SIZE="13">ledger_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">PK </FONT></TD></TR><TR><TD PORT="employee_id" ALIGN="LEFT"><FONT POINT-SIZE="13">employee_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">FK </FONT></TD></TR><TR><TD PORT="leave_type_id" ALIGN="LEFT"><FONT POINT-SIZE="13">leave_type_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">FK </FONT></TD></TR><TR><TD PORT="leave_id" ALIGN="LEFT"><FONT POINT-SIZE="13">leave_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">FK ?</FONT></TD></TR><TR><TD PORT="reversal_of" ALIGN="LEFT"><FONT POINT-SIZE="13">reversal_of</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">FK ?</FONT></TD></TR></TABLE>>];
"OVERTIME_REQUEST" [label=<<TABLE BORDER="1" COLOR="#cbd5df" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#102c43"><FONT COLOR="white" POINT-SIZE="15"><B>OVERTIME_REQUEST</B></FONT></TD></TR><TR><TD PORT="overtime_id" ALIGN="LEFT"><FONT POINT-SIZE="13">overtime_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">PK </FONT></TD></TR><TR><TD PORT="employee_id" ALIGN="LEFT"><FONT POINT-SIZE="13">employee_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">FK </FONT></TD></TR><TR><TD PORT="starts_at" ALIGN="LEFT"><FONT POINT-SIZE="13">starts_at</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">&#160;</FONT></TD></TR><TR><TD PORT="ends_at" ALIGN="LEFT"><FONT POINT-SIZE="13">ends_at</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">&#160;</FONT></TD></TR><TR><TD PORT="status" ALIGN="LEFT"><FONT POINT-SIZE="13">status</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">&#160;</FONT></TD></TR></TABLE>>];
"OVERTIME_SEGMENT" [label=<<TABLE BORDER="1" COLOR="#cbd5df" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#102c43"><FONT COLOR="white" POINT-SIZE="15"><B>OVERTIME_SEGMENT</B></FONT></TD></TR><TR><TD PORT="segment_id" ALIGN="LEFT"><FONT POINT-SIZE="13">segment_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">PK </FONT></TD></TR><TR><TD PORT="overtime_id" ALIGN="LEFT"><FONT POINT-SIZE="13">overtime_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">FK </FONT></TD></TR><TR><TD PORT="work_date" ALIGN="LEFT"><FONT POINT-SIZE="13">work_date</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">&#160;</FONT></TD></TR><TR><TD PORT="starts_at" ALIGN="LEFT"><FONT POINT-SIZE="13">starts_at</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">&#160;</FONT></TD></TR><TR><TD PORT="ends_at" ALIGN="LEFT"><FONT POINT-SIZE="13">ends_at</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">&#160;</FONT></TD></TR></TABLE>>];
"DEPENDENT_PERSON" [label=<<TABLE BORDER="1" COLOR="#cbd5df" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#102c43"><FONT COLOR="white" POINT-SIZE="15"><B>DEPENDENT_PERSON</B></FONT></TD></TR><TR><TD PORT="dependent_person_id" ALIGN="LEFT"><FONT POINT-SIZE="13">dependent_person_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">PK </FONT></TD></TR></TABLE>>];
"DEPENDENT_CLAIM" [label=<<TABLE BORDER="1" COLOR="#cbd5df" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#102c43"><FONT COLOR="white" POINT-SIZE="15"><B>DEPENDENT_CLAIM</B></FONT></TD></TR><TR><TD PORT="claim_id" ALIGN="LEFT"><FONT POINT-SIZE="13">claim_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">PK </FONT></TD></TR><TR><TD PORT="dependent_person_id" ALIGN="LEFT"><FONT POINT-SIZE="13">dependent_person_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">FK </FONT></TD></TR><TR><TD PORT="employee_id" ALIGN="LEFT"><FONT POINT-SIZE="13">employee_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">FK </FONT></TD></TR><TR><TD PORT="valid_from" ALIGN="LEFT"><FONT POINT-SIZE="13">valid_from</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">&#160;</FONT></TD></TR><TR><TD PORT="valid_to" ALIGN="LEFT"><FONT POINT-SIZE="13">valid_to</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">?</FONT></TD></TR><TR><TD PORT="status" ALIGN="LEFT"><FONT POINT-SIZE="13">status</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">&#160;</FONT></TD></TR></TABLE>>];
"LEAVE_TYPE" -> "LEAVE_REQUEST" [taillabel="1",headlabel="0..*",label=""];
"LEAVE_REQUEST" -> "LEAVE_DAY" [taillabel="1",headlabel="0..*",label=""];
"LEAVE_TYPE" -> "LEAVE_LEDGER" [taillabel="1",headlabel="0..*",label=""];
"LEAVE_REQUEST" -> "LEAVE_LEDGER" [taillabel="0..1",headlabel="0..*",label=""];
"LEAVE_LEDGER" -> "LEAVE_LEDGER" [taillabel="0..1",headlabel="0..1",label=""];
"OVERTIME_REQUEST" -> "OVERTIME_SEGMENT" [taillabel="1",headlabel="0..*",label=""];
"DEPENDENT_PERSON" -> "DEPENDENT_CLAIM" [taillabel="1",headlabel="0..*",label=""];
}