digraph ERD {
graph [rankdir=TB, nodesep=0.6, ranksep=0.7, splines=polyline, bgcolor="white", pad=0.3];
node [shape=plain, fontname="DejaVu Sans"];
edge [color="#7891a6",fontname="DejaVu Sans",fontsize=9,arrowsize=0.7];
"DEPARTMENT" [label=<<TABLE BORDER="1" COLOR="#cbd5df" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#102c43"><FONT COLOR="white" POINT-SIZE="15"><B>DEPARTMENT</B></FONT></TD></TR><TR><TD PORT="department_id" ALIGN="LEFT"><FONT POINT-SIZE="13">department_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">PK </FONT></TD></TR><TR><TD PORT="parent_id" ALIGN="LEFT"><FONT POINT-SIZE="13">parent_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">FK ?</FONT></TD></TR></TABLE>>];
"JOB_POSITION" [label=<<TABLE BORDER="1" COLOR="#cbd5df" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#102c43"><FONT COLOR="white" POINT-SIZE="15"><B>JOB_POSITION</B></FONT></TD></TR><TR><TD PORT="position_id" ALIGN="LEFT"><FONT POINT-SIZE="13">position_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">PK </FONT></TD></TR></TABLE>>];
"EMPLOYEE" [label=<<TABLE BORDER="1" COLOR="#cbd5df" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#102c43"><FONT COLOR="white" POINT-SIZE="15"><B>EMPLOYEE</B></FONT></TD></TR><TR><TD PORT="employee_id" ALIGN="LEFT"><FONT POINT-SIZE="13">employee_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">PK </FONT></TD></TR><TR><TD PORT="status" ALIGN="LEFT"><FONT POINT-SIZE="13">status</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">&#160;</FONT></TD></TR></TABLE>>];
"EMPLOYEE_ASSIGNMENT" [label=<<TABLE BORDER="1" COLOR="#cbd5df" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#102c43"><FONT COLOR="white" POINT-SIZE="15"><B>EMPLOYEE_ASSIGNMENT</B></FONT></TD></TR><TR><TD PORT="assignment_id" ALIGN="LEFT"><FONT POINT-SIZE="13">assignment_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">PK </FONT></TD></TR><TR><TD PORT="employee_id" ALIGN="LEFT"><FONT POINT-SIZE="13">employee_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">FK </FONT></TD></TR><TR><TD PORT="department_id" ALIGN="LEFT"><FONT POINT-SIZE="13">department_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">FK </FONT></TD></TR><TR><TD PORT="position_id" ALIGN="LEFT"><FONT POINT-SIZE="13">position_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">FK </FONT></TD></TR><TR><TD PORT="valid_from" ALIGN="LEFT"><FONT POINT-SIZE="13">valid_from</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">&#160;</FONT></TD></TR><TR><TD PORT="valid_to" ALIGN="LEFT"><FONT POINT-SIZE="13">valid_to</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">?</FONT></TD></TR></TABLE>>];
"EMPLOYMENT_CONTRACT" [label=<<TABLE BORDER="1" COLOR="#cbd5df" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#102c43"><FONT COLOR="white" POINT-SIZE="15"><B>EMPLOYMENT_CONTRACT</B></FONT></TD></TR><TR><TD PORT="contract_id" ALIGN="LEFT"><FONT POINT-SIZE="13">contract_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">PK </FONT></TD></TR><TR><TD PORT="employee_id" ALIGN="LEFT"><FONT POINT-SIZE="13">employee_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">FK </FONT></TD></TR><TR><TD PORT="valid_from" ALIGN="LEFT"><FONT POINT-SIZE="13">valid_from</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">&#160;</FONT></TD></TR><TR><TD PORT="valid_to" ALIGN="LEFT"><FONT POINT-SIZE="13">valid_to</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">?</FONT></TD></TR><TR><TD PORT="monthly_salary" ALIGN="LEFT"><FONT POINT-SIZE="13">monthly_salary</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">&#160;</FONT></TD></TR><TR><TD PORT="calendar_id" ALIGN="LEFT"><FONT POINT-SIZE="13">calendar_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">FK </FONT></TD></TR></TABLE>>];
"EMPLOYEE_BANK_ACCOUNT" [label=<<TABLE BORDER="1" COLOR="#cbd5df" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#102c43"><FONT COLOR="white" POINT-SIZE="15"><B>EMPLOYEE_BANK_ACCOUNT</B></FONT></TD></TR><TR><TD PORT="bank_account_id" ALIGN="LEFT"><FONT POINT-SIZE="13">bank_account_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">PK </FONT></TD></TR><TR><TD PORT="employee_id" ALIGN="LEFT"><FONT POINT-SIZE="13">employee_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">FK </FONT></TD></TR><TR><TD PORT="valid_from" ALIGN="LEFT"><FONT POINT-SIZE="13">valid_from</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">&#160;</FONT></TD></TR><TR><TD PORT="valid_to" ALIGN="LEFT"><FONT POINT-SIZE="13">valid_to</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">?</FONT></TD></TR><TR><TD PORT="status" ALIGN="LEFT"><FONT POINT-SIZE="13">status</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">&#160;</FONT></TD></TR></TABLE>>];
"DOCUMENT_FILE" [label=<<TABLE BORDER="1" COLOR="#cbd5df" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#102c43"><FONT COLOR="white" POINT-SIZE="15"><B>DOCUMENT_FILE</B></FONT></TD></TR><TR><TD PORT="document_id" ALIGN="LEFT"><FONT POINT-SIZE="13">document_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">PK </FONT></TD></TR></TABLE>>];
"DEPARTMENT" -> "DEPARTMENT" [taillabel="0..1",headlabel="0..*",label=""];
"EMPLOYEE" -> "EMPLOYEE_ASSIGNMENT" [taillabel="1",headlabel="0..*",label=""];
"DEPARTMENT" -> "EMPLOYEE_ASSIGNMENT" [taillabel="1",headlabel="0..*",label=""];
"JOB_POSITION" -> "EMPLOYEE_ASSIGNMENT" [taillabel="1",headlabel="0..*",label=""];
"EMPLOYEE" -> "EMPLOYMENT_CONTRACT" [taillabel="1",headlabel="0..*",label=""];
"DOCUMENT_FILE" -> "EMPLOYMENT_CONTRACT" [taillabel="0..1",headlabel="0..*",label=""];
"EMPLOYEE" -> "EMPLOYEE_BANK_ACCOUNT" [taillabel="1",headlabel="0..*",label=""];
}