digraph ERD {
graph [rankdir=TB, nodesep=0.6, ranksep=0.7, splines=polyline, bgcolor="white", pad=0.3];
node [shape=plain, fontname="DejaVu Sans"];
edge [color="#7891a6",fontname="DejaVu Sans",fontsize=9,arrowsize=0.7];
"PAYROLL_RUN" [label=<<TABLE BORDER="1" COLOR="#cbd5df" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#102c43"><FONT COLOR="white" POINT-SIZE="15"><B>PAYROLL_RUN</B></FONT></TD></TR><TR><TD PORT="run_id" ALIGN="LEFT"><FONT POINT-SIZE="13">run_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">PK </FONT></TD></TR><TR><TD PORT="period_id" ALIGN="LEFT"><FONT POINT-SIZE="13">period_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">FK </FONT></TD></TR><TR><TD PORT="input_version" ALIGN="LEFT"><FONT POINT-SIZE="13">input_version</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">&#160;</FONT></TD></TR><TR><TD PORT="policy_id" ALIGN="LEFT"><FONT POINT-SIZE="13">policy_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">FK </FONT></TD></TR><TR><TD PORT="status" ALIGN="LEFT"><FONT POINT-SIZE="13">status</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">&#160;</FONT></TD></TR></TABLE>>];
"PAYROLL_RESULT" [label=<<TABLE BORDER="1" COLOR="#cbd5df" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#102c43"><FONT COLOR="white" POINT-SIZE="15"><B>PAYROLL_RESULT</B></FONT></TD></TR><TR><TD PORT="result_id" ALIGN="LEFT"><FONT POINT-SIZE="13">result_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">PK </FONT></TD></TR><TR><TD PORT="run_id" ALIGN="LEFT"><FONT POINT-SIZE="13">run_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">FK </FONT></TD></TR><TR><TD PORT="employee_id" ALIGN="LEFT"><FONT POINT-SIZE="13">employee_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">FK </FONT></TD></TR><TR><TD PORT="department_id_snapshot" ALIGN="LEFT"><FONT POINT-SIZE="13">department_id_snapshot</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">FK </FONT></TD></TR><TR><TD PORT="net_amount" ALIGN="LEFT"><FONT POINT-SIZE="13">net_amount</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">&#160;</FONT></TD></TR></TABLE>>];
"PAYROLL_ITEM" [label=<<TABLE BORDER="1" COLOR="#cbd5df" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#102c43"><FONT COLOR="white" POINT-SIZE="15"><B>PAYROLL_ITEM</B></FONT></TD></TR><TR><TD PORT="item_id" ALIGN="LEFT"><FONT POINT-SIZE="13">item_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">PK </FONT></TD></TR><TR><TD PORT="result_id" ALIGN="LEFT"><FONT POINT-SIZE="13">result_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">FK </FONT></TD></TR><TR><TD PORT="component_id" ALIGN="LEFT"><FONT POINT-SIZE="13">component_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">FK </FONT></TD></TR><TR><TD PORT="department_id" ALIGN="LEFT"><FONT POINT-SIZE="13">department_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">FK </FONT></TD></TR><TR><TD PORT="amount" ALIGN="LEFT"><FONT POINT-SIZE="13">amount</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">&#160;</FONT></TD></TR><TR><TD PORT="policy_id" ALIGN="LEFT"><FONT POINT-SIZE="13">policy_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">FK </FONT></TD></TR></TABLE>>];
"PAYROLL_SNAPSHOT" [label=<<TABLE BORDER="1" COLOR="#cbd5df" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#102c43"><FONT COLOR="white" POINT-SIZE="15"><B>PAYROLL_SNAPSHOT</B></FONT></TD></TR><TR><TD PORT="snapshot_id" ALIGN="LEFT"><FONT POINT-SIZE="13">snapshot_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">PK </FONT></TD></TR><TR><TD PORT="result_id" ALIGN="LEFT"><FONT POINT-SIZE="13">result_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">FK </FONT></TD></TR></TABLE>>];
"PAYROLL_RUN" -> "PAYROLL_RESULT" [taillabel="1",headlabel="0..*",label=""];
"PAYROLL_RESULT" -> "PAYROLL_ITEM" [taillabel="1",headlabel="0..*",label=""];
"PAYROLL_RESULT" -> "PAYROLL_SNAPSHOT" [taillabel="1",headlabel="0..*",label=""];
}