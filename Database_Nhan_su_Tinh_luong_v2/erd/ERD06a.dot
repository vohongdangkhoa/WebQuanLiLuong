digraph ERD {
graph [rankdir=TB, nodesep=0.6, ranksep=0.7, splines=polyline, bgcolor="white", pad=0.3];
node [shape=plain, fontname="DejaVu Sans"];
edge [color="#7891a6",fontname="DejaVu Sans",fontsize=9,arrowsize=0.7];
"PAYROLL_PERIOD" [label=<<TABLE BORDER="1" COLOR="#cbd5df" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#102c43"><FONT COLOR="white" POINT-SIZE="15"><B>PAYROLL_PERIOD</B></FONT></TD></TR><TR><TD PORT="period_id" ALIGN="LEFT"><FONT POINT-SIZE="13">period_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">PK </FONT></TD></TR><TR><TD PORT="period_start" ALIGN="LEFT"><FONT POINT-SIZE="13">period_start</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">&#160;</FONT></TD></TR><TR><TD PORT="input_version" ALIGN="LEFT"><FONT POINT-SIZE="13">input_version</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">&#160;</FONT></TD></TR></TABLE>>];
"PAYROLL_RUN" [label=<<TABLE BORDER="1" COLOR="#cbd5df" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#102c43"><FONT COLOR="white" POINT-SIZE="15"><B>PAYROLL_RUN</B></FONT></TD></TR><TR><TD PORT="run_id" ALIGN="LEFT"><FONT POINT-SIZE="13">run_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">PK </FONT></TD></TR><TR><TD PORT="period_id" ALIGN="LEFT"><FONT POINT-SIZE="13">period_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">FK </FONT></TD></TR><TR><TD PORT="input_version" ALIGN="LEFT"><FONT POINT-SIZE="13">input_version</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">&#160;</FONT></TD></TR><TR><TD PORT="policy_id" ALIGN="LEFT"><FONT POINT-SIZE="13">policy_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">FK </FONT></TD></TR><TR><TD PORT="status" ALIGN="LEFT"><FONT POINT-SIZE="13">status</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">&#160;</FONT></TD></TR></TABLE>>];
"PAYROLL_ERROR" [label=<<TABLE BORDER="1" COLOR="#cbd5df" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#102c43"><FONT COLOR="white" POINT-SIZE="15"><B>PAYROLL_ERROR</B></FONT></TD></TR><TR><TD PORT="error_id" ALIGN="LEFT"><FONT POINT-SIZE="13">error_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">PK </FONT></TD></TR><TR><TD PORT="run_id" ALIGN="LEFT"><FONT POINT-SIZE="13">run_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">FK </FONT></TD></TR><TR><TD PORT="employee_id" ALIGN="LEFT"><FONT POINT-SIZE="13">employee_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">FK </FONT></TD></TR></TABLE>>];
"PAYROLL_APPROVAL" [label=<<TABLE BORDER="1" COLOR="#cbd5df" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#102c43"><FONT COLOR="white" POINT-SIZE="15"><B>PAYROLL_APPROVAL</B></FONT></TD></TR><TR><TD PORT="approval_id" ALIGN="LEFT"><FONT POINT-SIZE="13">approval_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">PK </FONT></TD></TR><TR><TD PORT="run_id" ALIGN="LEFT"><FONT POINT-SIZE="13">run_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">FK </FONT></TD></TR><TR><TD PORT="actor_id" ALIGN="LEFT"><FONT POINT-SIZE="13">actor_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">FK </FONT></TD></TR></TABLE>>];
"INPUT_CHANGE_REQUEST" [label=<<TABLE BORDER="1" COLOR="#cbd5df" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#102c43"><FONT COLOR="white" POINT-SIZE="15"><B>INPUT_CHANGE_REQUEST</B></FONT></TD></TR><TR><TD PORT="change_request_id" ALIGN="LEFT"><FONT POINT-SIZE="13">change_request_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">PK </FONT></TD></TR><TR><TD PORT="period_id" ALIGN="LEFT"><FONT POINT-SIZE="13">period_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">FK </FONT></TD></TR><TR><TD PORT="employee_id" ALIGN="LEFT"><FONT POINT-SIZE="13">employee_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">FK ?</FONT></TD></TR><TR><TD PORT="status" ALIGN="LEFT"><FONT POINT-SIZE="13">status</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#61768c" POINT-SIZE="11">&#160;</FONT></TD></TR></TABLE>>];
"PAYROLL_PERIOD" -> "PAYROLL_RUN" [taillabel="1",headlabel="0..*",label=""];
"PAYROLL_RUN" -> "PAYROLL_ERROR" [taillabel="1",headlabel="0..*",label=""];
"PAYROLL_RUN" -> "PAYROLL_APPROVAL" [taillabel="1",headlabel="0..*",label=""];
"PAYROLL_PERIOD" -> "INPUT_CHANGE_REQUEST" [taillabel="1",headlabel="0..*",label=""];
}