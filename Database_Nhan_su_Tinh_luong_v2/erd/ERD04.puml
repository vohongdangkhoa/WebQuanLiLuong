@startuml
hide circle
skinparam linetype ortho
entity LEAVE_TYPE {
  leave_type_id : NUMBER GENERATED BY
  leave_code : VARCHAR2(30 CHAR)
  leave_name : VARCHAR2(100 CHAR)
  paid_fraction : NUMBER(5,4)
  uses_balance : CHAR(1)
}
entity LEAVE_REQUEST {
  leave_id : NUMBER GENERATED BY
  employee_id : NUMBER
  leave_type_id : NUMBER
  starts_at : TIMESTAMP
  ends_at : TIMESTAMP
  reason : VARCHAR2(1000 CHAR)
  status : VARCHAR2(20 CHAR)
  requested_by : NUMBER
  decided_by : NUMBER
  decided_at : TIMESTAMP WITH TIME ZONE
  decision_reason : VARCHAR2(1000 CHAR)
  document_id : NUMBER
}
entity LEAVE_DAY {
  leave_id : NUMBER
  work_date : DATE
  minutes : NUMBER(5)
}
entity LEAVE_LEDGER {
  ledger_id : NUMBER GENERATED BY
  employee_id : NUMBER
  leave_type_id : NUMBER
  leave_id : NUMBER
  effective_date : DATE
  delta_minutes : NUMBER(8)
  source_key : VARCHAR2(100 CHAR)
  created_by : NUMBER
  reversal_of : NUMBER
}
entity OVERTIME_REQUEST {
  overtime_id : NUMBER GENERATED BY
  employee_id : NUMBER
  starts_at : TIMESTAMP
  ends_at : TIMESTAMP
  approved_minutes : NUMBER(6)
  actual_minutes : NUMBER(6)
  actual_starts_at : TIMESTAMP
  actual_ends_at : TIMESTAMP
  status : VARCHAR2(20 CHAR)
  requested_by : NUMBER
  approved_by : NUMBER
  confirmed_by : NUMBER
  reason : VARCHAR2(1000 CHAR)
}
entity OVERTIME_SEGMENT {
  segment_id : NUMBER GENERATED BY
  overtime_id : NUMBER
  work_date : DATE
  starts_at : TIMESTAMP
  ends_at : TIMESTAMP
  payable_minutes : NUMBER(5)
  is_night : CHAR(1)
}
entity DEPENDENT_PERSON {
  dependent_person_id : NUMBER GENERATED BY
  identity_hmac : VARCHAR2(128 CHAR)
  full_name : VARCHAR2(150 CHAR)
  birth_date : DATE
}
entity DEPENDENT_CLAIM {
  claim_id : NUMBER GENERATED BY
  dependent_person_id : NUMBER
  employee_id : NUMBER
  valid_from : DATE
  valid_to : DATE
  status : VARCHAR2(20 CHAR)
  document_id : NUMBER
  requested_by : NUMBER
  verified_by : NUMBER
  verified_at : TIMESTAMP WITH TIME ZONE
}
LEAVE_TYPE ||--o{ LEAVE_REQUEST : leave_type_id
LEAVE_REQUEST ||--o{ LEAVE_DAY : leave_id
LEAVE_TYPE ||--o{ LEAVE_LEDGER : leave_type_id
LEAVE_REQUEST |o--o{ LEAVE_LEDGER : leave_id
LEAVE_LEDGER |o--o| LEAVE_LEDGER : reversal_of
OVERTIME_REQUEST ||--o{ OVERTIME_SEGMENT : overtime_id
DEPENDENT_PERSON ||--o{ DEPENDENT_CLAIM : dependent_person_id
@enduml